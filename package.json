{
  "name": "matchstick-ts-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsheva/matchstick-ts.git"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/matchstick-ts\" --filter \"./packages/hardhat-matchstick-ts\" build",
    "test": "pnpm build && pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm --filter matchstick-ts test",
    "test:integration": "pnpm --filter matchstick-ts-example test",
    "test:fast": "pnpm build && pnpm test:unit && pnpm --filter matchstick-ts-example test:fast",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm check:code",
    "check:code": "pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
