{
  "name": "wasm-runner",
  "version": "0.0.0",
  "private": true,
  "description": "In-process Node.js WebAssembly runner for subgraph handlers — replaces `graph test` spawn in matchstick-ts.",
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "typescript": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build:example-bundle": "node scripts/build-bundle.mjs --handler-entry ../example/src/mapping.ts --out build/example-bundle.wasm",
    "pretest": "pnpm build:example-bundle",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@graphprotocol/graph-ts": "0.37.0",
    "@types/node": "^22.0.0",
    "assemblyscript": "0.19.23",
    "binaryen": "^129.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@assemblyscript/loader": "0.19.23",
    "viem": "^2.49.3",
    "yaml": "^2.9.0"
  }
}
